# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- application ---------------------------------------------------------
APP_ENV=local           # local | dev | staging | prod
LOG_LEVEL=INFO          # CRITICAL | ERROR | WARNING | INFO | DEBUG

# --- LLM boundary --------------------------------------------------------
# Nothing is connected yet. When Gemma is hosted behind an OpenAI-compatible
# endpoint, point these at it and register an app.services.llm.LlmService.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=          # leave empty here; supply via a secret manager, never in Git
MODEL_TIMEOUT_SECONDS=20

# --- policy --------------------------------------------------------------
# Timezone every calling-hour decision is made in. Never inherited from the host.
DEFAULT_TIMEZONE=Asia/Kolkata
POLICY_VERSION=0.1.0
# `as_of` of data/regulatory/catalog.json that the encoded rules were derived from.
REGULATORY_CORPUS_VERSION=2026-09-24
REGULATORY_RULES_PATH=data/regulatory/rules/recovery_rules.json

# Bank's own persistent-calling threshold. RBI prohibits "persistently calling"
# but prescribes no number, so this is unset by default and the corresponding
# rule reports itself as not evaluable rather than guessing a limit.
MAX_RECOVERY_CALLS_PER_DAY=

# --- session store -------------------------------------------------------
# In-memory only. Sessions do not survive a restart and are not shared between
# processes.
MAX_ACTIVE_SESSIONS=1000

# --- orchestrator --------------------------------------------------------
# Tool-loop safety stop: the most tool executions the orchestrator will perform
# for one customer turn. Not a regulatory or business number. The default of 2
# reflects the narrow payloads the banking tools return - the widest single
# question needs get_outstanding_amount plus get_account_status. When the limit
# is hit the turn stops, records an error and produces no answer; it never
# fabricates one.
MAX_TOOL_CALLS_PER_TURN=2
