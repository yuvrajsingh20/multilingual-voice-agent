# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- application ---------------------------------------------------------
APP_ENV=local           # local | dev | staging | prod
LOG_LEVEL=INFO          # CRITICAL | ERROR | WARNING | INFO | DEBUG

# --- LLM boundary --------------------------------------------------------
# A remote OpenAI-compatible chat-completions endpoint. Provider-neutral: the
# dialect is the API and the model is whatever MODEL_NAME says, so the same
# configuration serves vLLM, llama.cpp, TGI or OpenAI itself.
#
# NO MODEL IS CONNECTED. Leave both MODEL_BASE_URL and MODEL_NAME empty and the
# application keeps NotConfiguredLlmService and constructs no HTTP client at
# all - which is what stops a test run or a fresh checkout reaching a network.
# Setting exactly one of the two is rejected at startup: the application will
# not guess the other, and never falls back to a different model.

# Include the API version. Must be http:// or https://.
MODEL_BASE_URL=
# The model identifier exactly as the serving layer exposes it.
MODEL_NAME=
# Sent as `Authorization: Bearer`. Never logged, never in an error, never in a
# repr. Leave empty here; supply via a secret manager, never in Git. A local
# server that needs no key should leave this blank - no header is then sent.
MODEL_API_KEY=

# Total wall-clock budget for one model call, in seconds (at most 600). Every
# attempt, every HTTP phase within it (connect, send, each read) and the wait
# between attempts share this one clock. It is not a fresh budget per try or
# per phase. The steps it cannot interrupt are listed in REPORT.md, final
# section, H.10: DNS resolution chief among them.
MODEL_TIMEOUT_SECONDS=20
# Connection-establishment budget. Unset falls back to MODEL_TIMEOUT_SECONDS.
MODEL_CONNECT_TIMEOUT_SECONDS=
# Cap on generated tokens, and sampling temperature. Unset leaves LlmRequest's
# own defaults (512 and 0.2) in force. A reply cut off by the cap
# (finish_reason "length") is never spoken: the turn fails as
# llm_incomplete_response. Blank here means unset.
MODEL_MAX_OUTPUT_TOKENS=
MODEL_TEMPERATURE=
# Bounded retries, off by default. Leave this at 0 until a real model has been
# measured. When raised, only a connection that never opened, and
# 408/429/500/502/503/504, are retried, after a backoff that honors Retry-After
# when it fits the shared budget, and only if a quarter of the budget is still
# left for the retry. A retried status means the server received the request,
# so the customer's words are sent again. A read timeout is never retried. Max 3.
MODEL_MAX_RETRIES=0
# Log label only. Never affects request construction.
MODEL_PROVIDER=openai-compatible

# --- policy --------------------------------------------------------------
# Timezone every calling-hour decision is made in. Never inherited from the host.
DEFAULT_TIMEZONE=Asia/Kolkata
POLICY_VERSION=0.1.0
# `as_of` of data/regulatory/catalog.json that the encoded rules were derived from.
REGULATORY_CORPUS_VERSION=2026-09-24
# Unset uses the repository's data/regulatory/rules/recovery_rules.json, by
# absolute path. A relative path set here is resolved against the process's
# working directory, not the repository.
# REGULATORY_RULES_PATH=data/regulatory/rules/recovery_rules.json

# Bank's own persistent-calling threshold. RBI prohibits "persistently calling"
# but prescribes no number, so this is unset by default and the corresponding
# rule reports itself as not evaluable rather than guessing a limit.
MAX_RECOVERY_CALLS_PER_DAY=

# --- session store -------------------------------------------------------
# In-memory only. Sessions do not survive a restart and are not shared between
# processes.
MAX_ACTIVE_SESSIONS=1000

# --- orchestrator --------------------------------------------------------
# Tool-loop safety stop: the most tool executions the orchestrator will perform
# for one customer turn. Not a regulatory or business number. The default of 2
# reflects the narrow payloads the banking tools return - the widest single
# question needs get_outstanding_amount plus get_account_status. When the limit
# is hit the turn stops, records an error and produces no answer; it never
# fabricates one.
MAX_TOOL_CALLS_PER_TURN=2
